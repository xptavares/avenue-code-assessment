<p class="mb-4"><%= link_to "New search", root_path, class: "underline" %></p>

<h1 class="text-2xl font-bold mb-2">Forecast for <%= @address %></h1>

<% if @cached %>
  <p class="mb-2 text-gray-500">Cached result. Forecasts are refreshed every 30 minutes.</p>
<% end %>

<h2 class="text-xl font-semibold mt-6 mb-2">Today, <%= l(@today.date, format: :long) %></h2>

<p>Now: <%= temperature(@forecast.current_temperature) %></p>
<p>High: <%= temperature(@today.high) %> / Low: <%= temperature(@today.low) %></p>
<p>Chance of rain: <%= @today.precipitation_probability %>% (<%= @today.precipitation_sum %> mm)</p>

<h3 class="text-lg font-semibold mt-6 mb-2">Hourly</h3>

<table class="w-full text-left">
  <thead>
    <tr class="border-b">
      <th>Hour</th>
      <th>Temperature</th>
      <th>Chance of rain</th>
      <th>Precipitation</th>
    </tr>
  </thead>
  <tbody>
    <% @today.hours.each do |hour| %>
      <tr class="border-b">
        <td><%= hour.time.strftime("%H:%M") %></td>
        <td><%= temperature(hour.temperature) %></td>
        <td><%= hour.precipitation_probability %>%</td>
        <td><%= hour.precipitation %> mm</td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2 class="text-xl font-semibold mt-6 mb-2">Next days</h2>

<table class="w-full text-left">
  <thead>
    <tr class="border-b">
      <th>Date</th>
      <th>High</th>
      <th>Low</th>
      <th>Chance of rain</th>
      <th>Precipitation</th>
    </tr>
  </thead>
  <tbody>
    <% @next_days.each do |day| %>
      <tr class="border-b">
        <td><%= l(day.date, format: "%a, %b %-d") %></td>
        <td><%= temperature(day.high) %></td>
        <td><%= temperature(day.low) %></td>
        <td><%= day.precipitation_probability %>%</td>
        <td><%= day.precipitation_sum %> mm</td>
      </tr>
    <% end %>
  </tbody>
</table>
