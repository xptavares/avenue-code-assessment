<h1 class="text-2xl font-bold mb-6">Weather Forecast</h1>

<% if alert %>
  <p class="mb-4 text-red-600"><%= alert %></p>
<% end %>

<div data-controller="tabs">
  <div class="flex gap-6 border-b mb-6">
    <button type="button" class="pb-2 border-b-2 border-black cursor-pointer" data-tabs-target="tab" data-action="tabs#select">Server-rendered</button>
    <button type="button" class="pb-2 cursor-pointer" data-tabs-target="tab" data-action="tabs#select">JSON API</button>
  </div>

  <div data-tabs-target="panel">
    <p class="mb-4 text-gray-500">Submits the form and Rails renders the forecast page.</p>

    <%= form_with scope: :address, url: forecast_path, method: :get, class: "space-y-4" do |f| %>
      <%= render "address_fields", f:, address: @address %>
    <% end %>
  </div>

  <div data-tabs-target="panel" data-controller="forecast" hidden>
    <p class="mb-4 text-gray-500">Fetches the forecast as JSON and renders it here with JavaScript.</p>

    <%= form_with scope: :address, url: forecast_path, method: :get, namespace: "json", class: "space-y-4",
          data: { forecast_target: "form", action: "forecast#submit" } do |f| %>
      <%= render "address_fields", f:, address: @address %>
    <% end %>

    <div class="mt-8" data-forecast-target="result"></div>
  </div>
</div>
